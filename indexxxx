<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Brevet blanc — Mathématiques</title>
<style>
:root{--blue:#0021BC;--blue-lt:#BDD4E7;--orange:#EE6E34;--bg:#EDEEF0;--white:#FFFFFF;--ink:rgb(25,8,6);--muted:#8A8DAA;--green:#22C55E;--fd:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:var(--bg);font-family:var(--fd);-webkit-font-smoothing:antialiased;}
.nav{display:flex;justify-content:space-between;align-items:flex-start;padding:20px 32px 0;background:var(--bg);flex-shrink:0;position:relative;z-index:10;}
.logo{cursor:pointer;text-decoration:none;color:inherit;flex-shrink:0}
.logo a{text-decoration:none;color:inherit}
.logo-top{font-size:12px;color:var(--ink);display:block}
.logo-bot{font-size:28px;font-weight:800;letter-spacing:-.04em;line-height:.9;text-transform:uppercase;display:block}
.logo-bot span{color:var(--blue)}
.nav-center{display:flex;align-items:center;gap:32px;flex:1;justify-content:center}
.nav-r{display:flex;align-items:center;gap:12px}
.timer-wrap{display:flex;align-items:center;gap:8px;background:var(--white);border:1.5px solid rgba(0,0,0,.08);border-radius:100px;padding:7px 16px}
.timer-dot{width:8px;height:8px;border-radius:50%;background:var(--orange);animation:pulse 1s ease-in-out infinite;flex-shrink:0}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.timer-val{font-size:13px;font-weight:600;letter-spacing:-.01em;color:var(--ink)}
.pts-pill{font-size:12px;font-weight:600;color:var(--blue);background:#EEF2FF;padding:7px 16px;border-radius:100px;border:1.5px solid rgba(0,33,188,.15)}
.stage{display:flex;flex-direction:column;width:100%;position:absolute;top:68px;bottom:0;left:0;right:0;overflow:hidden;background:var(--bg)}
.main{display:grid;grid-template-columns:210px 1fr;overflow:hidden;flex:1;padding:12px 20px 16px;gap:10px;align-items:stretch;min-height:0;height:100%}
.sidebar{background:var(--white);border-radius:18px;border:1.5px solid rgba(0,0,0,.08);padding:14px 12px;display:flex;flex-direction:column;gap:10px;overflow:hidden}
.sidebar-label{font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.ex-list{display:flex;flex-direction:column;gap:4px}
.ex-item{border-radius:10px;cursor:pointer;border:1.5px solid transparent;overflow:hidden;transition:background .15s}
.ex-item:hover .ex-header{background:var(--bg)}
.ex-item.active .ex-header{background:#EEF2FF}
.ex-item.active{border-color:rgba(0,33,188,.15)}
.ex-item.done{border-color:rgba(34,197,94,.2)}
.ex-item.done .ex-header{background:#EDFBF0}
.ex-header{display:flex;align-items:center;gap:10px;padding:8px 10px}
.ex-num{width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0}
.ex-item.active .ex-num{background:var(--blue);color:#fff}
.ex-item.done .ex-num{background:var(--green);color:#fff}
.ex-item:not(.active):not(.done) .ex-num{background:var(--bg);color:var(--muted)}
.ex-info{flex:1;min-width:0}
.ex-name{font-size:12px;font-weight:500;letter-spacing:-.01em;text-transform:lowercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ex-sub{font-size:10px;color:var(--muted);margin-top:2px;font-weight:300}
.ex-dots{display:flex;gap:4px;padding:4px 10px 8px 46px}
.dot{width:7px;height:7px;border-radius:50%;background:rgba(0,0,0,.1);transition:background .2s;cursor:pointer}
.dot.done{background:var(--green)}
.dot.active{background:var(--blue)}
.sidebar-progress{margin-top:auto;padding-top:10px;border-top:1px solid rgba(0,0,0,.06)}
.prog-label{font-size:10px;color:var(--muted);display:flex;justify-content:space-between;margin-bottom:6px;font-weight:500}
.prog-bar{height:4px;background:rgba(0,0,0,.07);border-radius:100px;overflow:hidden}
.prog-fill{height:100%;background:var(--blue);border-radius:100px;transition:width .4s ease}
.content{display:flex;flex-direction:column;overflow:hidden;min-height:0}
.question-card{background:var(--white);border-radius:18px;border:1.5px solid rgba(0,0,0,.08);overflow:hidden;display:grid;grid-template-rows:auto auto 1fr auto;height:100%;min-height:0}
.card-header{display:flex;align-items:center;justify-content:space-between;padding:10px 22px;border-bottom:1px solid rgba(0,0,0,.06);background:var(--white);flex-shrink:0}
.card-footer{display:flex;align-items:center;justify-content:space-between;padding:10px 22px;border-top:1px solid rgba(0,0,0,.06);background:var(--white);flex-shrink:0}
.card-prog{height:3px;background:rgba(0,0,0,.06);flex-shrink:0}
.card-prog-fill{height:100%;background:var(--blue);transition:width .3s}
.q-meta{display:flex;align-items:center;gap:8px}
.q-tag{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:4px 12px;border-radius:100px;background:#EEF2FF;color:var(--blue)}
.q-pts-badge{font-size:11px;font-weight:500;color:var(--muted)}
.q-breadcrumb{font-size:11px;color:var(--muted);font-weight:500;text-align:right;line-height:1.5}
.q-breadcrumb strong{color:var(--ink);font-weight:600}
.card-body{display:grid;grid-template-columns:1fr auto;overflow:hidden;flex:1}
.card-body.no-figure{grid-template-columns:1fr}
.card-main{display:grid;grid-template-rows:auto 1fr;overflow:hidden;padding:18px 26px;gap:12px}
.q-block{display:flex;flex-direction:column;gap:10px;flex-shrink:0}
.q-stimulus{background:var(--bg);border-left:3px solid var(--blue-lt);border-radius:0 8px 8px 0;padding:10px 16px;font-size:13px;line-height:1.7;font-weight:300}
.q-stimulus-label{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.q-number-label{font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--blue);display:flex;align-items:center;gap:8px}
.q-number-label::after{content:'';flex:0 0 28px;height:1.5px;background:var(--blue-lt);border-radius:2px}
.q-text{font-size:14px;font-weight:400;line-height:1.8;color:var(--ink)}
.answer-block{display:flex;flex-direction:column;gap:6px;overflow:hidden;min-height:0}
.answer-label{font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--muted)}
.answer-textarea{flex:1;width:100%;font-family:var(--fd);font-size:14px;line-height:1.75;border:1.5px solid rgba(0,0,0,.1);border-radius:12px;padding:12px 16px;resize:none;background:var(--bg);color:var(--ink);outline:none;transition:border-color .15s;min-height:0}
.answer-textarea:focus{border-color:var(--blue);background:var(--white)}
.answer-hint{font-size:10px;color:var(--muted);text-align:right;flex-shrink:0}
.card-figure{width:230px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:14px 10px;border-left:1px solid rgba(0,0,0,.06);background:var(--bg);flex-shrink:0}
.fig-label{font-size:10px;color:var(--muted);text-align:center;margin-top:8px;font-style:italic;line-height:1.4}
.btn{font-family:var(--fd);font-size:13px;font-weight:600;border:none;border-radius:100px;cursor:pointer;padding:9px 20px;transition:opacity .15s;display:inline-flex;align-items:center;gap:6px;text-transform:lowercase;letter-spacing:-.01em}
.btn:hover{opacity:.85}
.btn-ghost{background:transparent;border:1.5px solid rgba(0,0,0,.14);color:var(--ink)}
.btn-primary{background:var(--blue);color:#fff}
.btn-orange{background:var(--orange);color:#fff}
.step-info{font-size:12px;color:var(--muted);text-align:center;font-weight:300}
.end-screen{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:20px;text-align:center;padding:40px}
</style>
</head>
