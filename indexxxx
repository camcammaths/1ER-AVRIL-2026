    ]}
];

const answers={};let curEx=1,curQ=0;const doneSet=new Set();
function key(e,q){return e+"-"+q}
function totalDone(){return doneSet.size}
function totalQ(){return exercises.reduce((s,e)=>s+e.questions.length,0)}
function totalPts(){return exercises.reduce((s,e)=>s+e.pts,0)}

function buildSidebar(){
  const el=document.getElementById("exList");el.innerHTML="";
  exercises.forEach(ex=>{
    const isActive=ex.id===curEx;
    const allDone=ex.questions.every((_,i)=>doneSet.has(key(ex.id,i)));
    const item=document.createElement("div");
    item.className="ex-item"+(isActive?" active":"")+(allDone&&!isActive?" done":"");
    const dots=ex.questions.map((_,i)=>{
      const d=doneSet.has(key(ex.id,i));const a=isActive&&i===curQ;
      return '<div class="dot '+(d?"done":"")+" "+(a?"active":"")+'" onclick="jumpTo('+ex.id+','+i+')"></div>';
    }).join("");
    item.innerHTML='<div class="ex-header"><div class="ex-num">'+(allDone&&!isActive?"✓":ex.num)+'</div><div class="ex-info"><div class="ex-name">'+ex.name+'</div><div class="ex-sub">'+ex.sub+'</div></div></div><div class="ex-dots">'+dots+'</div>';
    item.querySelector(".ex-header").onclick=()=>jumpTo(ex.id,0);
    el.appendChild(item);
  });
  const done=totalDone(),total=totalQ(),pct=Math.round(done/total*100);
  document.getElementById("progText").textContent=done+" / "+total+" questions";
  document.getElementById("progPct").textContent=pct+"%";
  document.getElementById("progFill").style.width=pct+"%";
  document.getElementById("ptsPill").textContent=Math.min(done,totalPts())+" / "+totalPts()+" pts";
}

function buildQuestion(){
  const ex=exercises.find(e=>e.id===curEx);
  const q=ex.questions[curQ];
  const card=document.getElementById("questionCard");
  const hasFig=!!(ex.figure);
  const saved=answers[key(curEx,curQ)]||"";
  const progPct=Math.round(curQ/ex.questions.length*100);
  const stimHTML=ex.stimulus?'<div style="font-size:13px;font-weight:300;line-height:1.7;color:var(--ink);margin-bottom:6px;font-style:italic">'+ex.stimulus.split("\n").map(l=>'<p style="margin-bottom:.18em">'+l+'</p>').join("")+'</div>':"";
  const contextHTML=q.context?'<p style="font-size:13px;font-weight:300;line-height:1.7;color:var(--ink);margin-bottom:6px;font-style:italic">'+q.context+'</p>':"";

  // Résoudre la figure à utiliser
  const fig = q.figureOverride || (ex.id===1 ? figureVelo : (ex.figure||""));
  const figLbl = q.figureOverride ? "" : (ex.figureLabel||"");

  let bodyHTML;
  if(q.figureWide){
    // Layout 2 colonnes : figure/contexte à gauche, question+réponse à droite
    const leftContent =
      (q.context?'<p style="font-size:12px;font-weight:300;line-height:1.65;color:var(--ink);font-style:italic;flex-shrink:0">'+q.context+'</p>':"")
      + (stimHTML?stimHTML:"")
      +'<div style="background:var(--white);border-radius:12px;padding:12px 8px 8px;border:1.5px solid rgba(0,0,0,.06);flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:0">'+fig+(figLbl?'<div style="font-size:10px;color:var(--muted);text-align:center;margin-top:6px;font-style:italic">'+figLbl+'</div>':"")+'</div>';
    bodyHTML='<div class="card-body no-figure" style="display:grid;grid-template-columns:1fr 1fr;overflow:hidden;gap:0">'
      +'<div style="overflow-y:auto;padding:14px 18px;border-right:1px solid rgba(0,0,0,.06);display:flex;flex-direction:column;gap:10px;min-height:0">'+leftContent+'</div>'
      +'<div style="display:flex;flex-direction:column;overflow:hidden;padding:14px 18px;gap:12px">'
        +'<div class="q-block" style="flex-shrink:0"><div class="q-number-label">Question '+(curQ+1)+'</div><div class="q-text">'+q.text+'</div></div>'
        +'<div class="answer-block" style="flex:1;min-height:0"><div class="answer-label">Ta réponse</div><textarea class="answer-textarea" id="answerTA" placeholder="Rédige tes calculs et réponses ici…">'+saved+'</textarea><div class="answer-hint" id="ansHint">'+cw(saved)+' mot(s)</div></div>'
      +'</div></div>';
  } else {
    // Layout standard : stimulus + contexte + question, pleine largeur
    bodyHTML='<div class="card-body no-figure"><div class="card-main"><div class="q-block">'+stimHTML+contextHTML+'<div class="q-number-label">Question '+(curQ+1)+'</div><div class="q-text">'+q.text+'</div></div><div class="answer-block"><div class="answer-label">Ta réponse</div><textarea class="answer-textarea" id="answerTA" placeholder="Rédige tes calculs et réponses ici…">'+saved+'</textarea><div class="answer-hint" id="ansHint">'+cw(saved)+' mot(s)</div></div></div></div>';
  }

  card.innerHTML='<div class="card-header"><div class="q-meta"><span class="q-tag">Ex. '+ex.id+' — '+ex.name+'</span><span class="q-pts-badge">'+q.pts+' pts</span></div><div class="q-breadcrumb">Question <strong>'+(curQ+1)+'</strong> / '+ex.questions.length+'</div></div><div class="card-prog"><div class="card-prog-fill" style="width:'+progPct+'%"></div></div>'+bodyHTML+'<div class="card-footer" id="footerNav"></div>';

  const ta=document.getElementById("answerTA");
  ta.addEventListener("input",()=>{answers[key(curEx,curQ)]=ta.value;document.getElementById("ansHint").textContent=cw(ta.value)+" mot(s)";});
  buildFooter(ex);
}

function cw(s){return s.trim().split(/\s+/).filter(Boolean).length}

function buildFooter(ex){
  const nav=document.getElementById("footerNav");
  const isLastQ=curQ===ex.questions.length-1,isLastEx=ex.id===exercises[exercises.length-1].id,isFirst=curEx===exercises[0].id&&curQ===0;
  const gi=getGI(),gt=totalQ();
  nav.innerHTML=((!isFirst)?'<button class="btn btn-ghost" onclick="goPrev()">← précédent</button>':'<div></div>')+'<div class="step-info">Question '+(gi+1)+' sur '+gt+' au total</div>'+(isLastQ&&isLastEx?'<button class="btn btn-orange" onclick="handleSubmit()">Terminer l\'examen →</button>':'<button class="btn btn-primary" onclick="goNext()">Valider →</button>');
}

function getGI(){let i=0;for(const ex of exercises){if(ex.id===curEx)return i+curQ;i+=ex.questions.length;}return i;}
function saveAnswer(){const ta=document.getElementById("answerTA");if(ta)answers[key(curEx,curQ)]=ta.value;}
function goNext(){
  saveAnswer();doneSet.add(key(curEx,curQ));
  const ex=exercises.find(e=>e.id===curEx);
  if(curQ<ex.questions.length-1){curQ++;}
  else{const nx=exercises.find(e=>e.id===curEx+1);if(nx){curEx=nx.id;curQ=0;}}
  buildSidebar();buildQuestion();
}
function goPrev(){
  saveAnswer();
  if(curQ>0){curQ--;}
  else{const px=exercises.find(e=>e.id===curEx-1);if(px){curEx=px.id;curQ=px.questions.length-1;}}
  buildSidebar();buildQuestion();
}
function jumpTo(exId,qIdx){saveAnswer();curEx=exId;curQ=qIdx;buildSidebar();buildQuestion();}
function handleSubmit(){
  saveAnswer();doneSet.add(key(curEx,curQ));buildSidebar();
  document.getElementById("questionCard").innerHTML='<div class="end-screen"><div style="font-size:2.8em;font-family:var(--fd);font-weight:800;color:var(--blue);letter-spacing:-.04em;line-height:1.05">brevet blanc<br>terminé !</div><p style="font-size:.85em;color:var(--muted);max-width:30em;line-height:1.7">Ton devoir a bien été soumis. Les corrections seront disponibles dans ton espace <strong>mon parcours</strong>.</p><div style="display:flex;gap:1em;margin-top:.4em"><button class="btn btn-ghost" onclick="jumpTo(1,0)">Revoir mes réponses</button><button class="btn btn-primary">Voir les corrections →</button></div></div>';
}
function tick(){
  if(totalSecs<=0){document.getElementById("timerVal").textContent="0:00:00";document.getElementById("timerDot").style.background="#E24B4A";return;}
  totalSecs--;
  const h=Math.floor(totalSecs/3600),m=Math.floor((totalSecs%3600)/60),s=totalSecs%60;
  document.getElementById("timerVal").textContent=h+":"+String(m).padStart(2,"0")+":"+String(s).padStart(2,"0");
  if(totalSecs<900)document.getElementById("timerDot").style.background="#E24B4A";
}
let totalSecs=7200;
buildSidebar();buildQuestion();setInterval(tick,1000);
</script>
</body>
</html>
